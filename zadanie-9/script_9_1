# 9.1

# Plot functions sin(x), cos(x), and exp(-x) in a range [0,10] in the same figure.
# Colors are red, green, and blue, respectively. Lines are solid, dashed,
# and dotted, respectively. Add a legend.

import numpy as np
import matplotlib.pyplot as plt

x = np.linspace(0, 10, 1000)

plt.plot(x, np.sin(x), 'r-', label = 'y = sin(x)')
plt.plot(x, np.cos(x), 'g--', label = 'y = cos(x)')
plt.plot(x, np.exp(-x), 'b:', label = 'y = exp(-x)')
plt.legend()
plt.show()
