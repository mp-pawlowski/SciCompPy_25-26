# Create pd.Series where index contains days of the current month
# (numpy.datetime64 instances or pandas.DatetimeIndex) and data contains
# some numbers (temperatures at noon, currency rates, ...).

import pandas as pd
import numpy as np

days = np.arange(np.datetime64("2026-05-01"), np.datetime64("2026-06-01"))

temp_max_krk = [19, 20, 26, 27, 28, 26, 20,
               16, 14, 19, 20, 16, 14, 19,
               17, 13, 11, 15, 19, 21, 22,
               18, 18, 21, 24, 25, 20, 20,
               20, 20, 20]

may_temps = pd.Series(temp_max_krk, index = days)

may_temps
